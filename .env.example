# TRUSTEQ - Secure Agentic Depot Onboarding
# Copy to ".env" for local overrides. ".env" is git-ignored: never commit it.
# Every value below is a safe placeholder. The default application runs
# WITHOUT any external API key (AI execution mode "scripted").
# All variables use the TRUSTEQ_ prefix to avoid clashes with other tools.

TRUSTEQ_APP_NAME=TRUSTEQ Secure Agentic Depot Onboarding
# development | test | production
TRUSTEQ_ENVIRONMENT=development
TRUSTEQ_DEBUG=false
TRUSTEQ_API_VERSION=v1

# SQLite file is created later (Phase 01); it is git-ignored.
TRUSTEQ_DATABASE_URL=sqlite:///./trusteq.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
TRUSTEQ_LOG_LEVEL=INFO
# true = one JSON object per log line, false = human-readable lines
TRUSTEQ_LOG_JSON=true

# scripted = deterministic agent, no API key needed (default)
# llm      = real model-backed agent; requires TRUSTEQ_ENABLE_LLM=true, TRUSTEQ_LLM_PROVIDER=anthropic
#            and an API key. Bank policy and the tool boundary are the same in both modes.
TRUSTEQ_AI_EXECUTION_MODE=scripted
TRUSTEQ_ENABLE_LLM=false

# LLM provider configuration (ignored in scripted mode; only "anthropic" is implemented).
TRUSTEQ_LLM_PROVIDER=
# The evaluated, pinned model (see docs/phase-05-evaluation.md).
TRUSTEQ_LLM_MODEL=claude-sonnet-5-5
TRUSTEQ_LLM_BASE_URL=
# Never put a real key in this example file. In your local, git-ignored .env use
# ANTHROPIC_API_KEY=<your key> (or this variable). It is never logged or printed.
TRUSTEQ_LLM_API_KEY=
# Bounds of one agent run: low | medium | high thinking effort, output tokens per model request,
# model requests per run, seconds per request, SDK retries of one request.
TRUSTEQ_LLM_EFFORT=medium
TRUSTEQ_LLM_MAX_OUTPUT_TOKENS=4096
TRUSTEQ_LLM_MAX_TOOL_ROUNDS=8
TRUSTEQ_LLM_TIMEOUT_SECONDS=60
TRUSTEQ_LLM_MAX_RETRIES=1
# The bank's own question answering, in LLM mode: a question needs a verified credential, and one
# process makes at most this many paid model runs. Scripted mode costs nothing and stays public.
TRUSTEQ_LLM_QUESTIONS_REQUIRE_CREDENTIAL=true
TRUSTEQ_LLM_MAX_QUESTIONS_PER_PROCESS=200

# DEV/TEST ONLY: allows the trusted bootstrap CLI (python -m scripts.dev_auth) to issue an
# agent's first, narrow token (scope create_draft). There is NO HTTP endpoint for it. Agents
# always call the API with "Authorization: Bearer <token>" (the old X-Dev-Actor-Id header was
# removed in Phase 03). Controlled development authorization - not production OAuth/FAPI.
# Ignored in production, and production refuses to start if this is set to true.
TRUSTEQ_DEV_AGENT_BOOTSTRAP_ENABLED=true

# DEV/TEST ONLY simulated customer sign-in for the bank-controlled confirmation page
# (dev sign-in form). Not identity verification; ignored in production.
TRUSTEQ_DEV_CUSTOMER_AUTH_ENABLED=true

# DEV/TEST ONLY trusted operator CLI for human review (python -m scripts.dev_operator).
# Synthetic operator identities; no operator HTTP endpoint. Ignored in production.
TRUSTEQ_DEV_OPERATOR_CLI_ENABLED=true

# Lifetimes in seconds: customer handoff challenge, onboarding grant (and its token), agent
# bootstrap grant, read-only status grant, customer session on the bank-controlled pages.
TRUSTEQ_HANDOFF_TTL_SECONDS=600
TRUSTEQ_MANDATE_TTL_SECONDS=3600
TRUSTEQ_AGENT_BOOTSTRAP_TTL_SECONDS=900
TRUSTEQ_AGENT_STATUS_TTL_SECONDS=86400
TRUSTEQ_CUSTOMER_SESSION_TTL_SECONDS=900

# Shared secret of the MOCK depot provider's signed callback. Leave EMPTY to disable the
# callback endpoint. Set a long random value only for local demos; never commit it.
# Production refuses to start when this is set.
TRUSTEQ_MOCK_PROVIDER_CALLBACK_SECRET=

# How the MOCK depot provider's versioned API behaves: current_v2, v1_only, v2_deprecated_fallback,
# v2_retired_no_fallback, unsupported_version, malformed_response, provider_unavailable,
# provider_timeout or manipulated_opened.
TRUSTEQ_MOCK_DEPOT_SCENARIO=current_v2

# Synthetic tax information and the knowledge-and-experience questions come before the customer's
# confirmation. Set to false only to reproduce the original P0 scenarios.
TRUSTEQ_CUSTOMER_INFORMATION_REQUIRED=true

# dev_simulated: the labelled DEV sign-in. oidc: a boundary only; no identity provider is configured,
# so the DEV sign-in is switched off and customer pages fail closed. Never commit a client secret.
TRUSTEQ_CUSTOMER_IDENTITY_MODE=dev_simulated
TRUSTEQ_OIDC_ISSUER=
TRUSTEQ_OIDC_CLIENT_ID=
TRUSTEQ_OIDC_CLIENT_SECRET=
TRUSTEQ_OIDC_REDIRECT_URI=
TRUSTEQ_OIDC_JWKS_URI=

# A plain-http OIDC provider and test providers on loopback only. Refused in production.
TRUSTEQ_OIDC_ALLOW_INSECURE_LOCAL=false

# The origin published in discovery metadata and checked in DPoP proofs. Never taken from a request.
TRUSTEQ_PUBLIC_BASE_URL=http://127.0.0.1:8000
# The provider's metadata signing key: a private EC JWK in JSON. Blank outside production means a
# fresh key per process. It proves integrity, not identity or authorization. Never commit one.
TRUSTEQ_PROVIDER_SIGNING_JWK=
# The federation superior named in authority_hints. Only a synthetic authority exists here.
TRUSTEQ_TRUST_SUPERIOR_ENTITY=

# Makes identity proofing, contract signing, attribution and policy evidence mandatory gates.
# It needs TRUSTEQ_CUSTOMER_IDENTITY_MODE=oidc: with dev_simulated the application refuses to start.
# Without a complete OIDC configuration, customer pages fail closed.
TRUSTEQ_FULL_TRUST_PROFILE=false
TRUSTEQ_DELEGATION_TTL_SECONDS=1800
TRUSTEQ_DELEGATION_REQUEST_TTL_SECONDS=600

# Vendor-neutral signing boundary. QES needs a real, named QTSP; none exists for this project.
TRUSTEQ_SIGNATURE_PROVIDER_ID=
TRUSTEQ_SIGNATURE_PROVIDER_URL=
TRUSTEQ_SIGNATURE_PROVIDER_JWKS=
TRUSTEQ_SIGNATURE_PROVIDER_API_KEY=
TRUSTEQ_SIGNATURE_LEVEL=TEST_NO_LEGAL_EFFECT
TRUSTEQ_QTSP_ID=
TRUSTEQ_SIGNATURE_TTL_SECONDS=900

# Vendor-neutral identity-proofing boundary. No real eID, VideoIdent or EUDI wallet provider exists
# here. "regulated" is refused outside production and needs a contract.
TRUSTEQ_PROOFING_PROVIDER_ID=
TRUSTEQ_PROOFING_PROVIDER_URL=
TRUSTEQ_PROOFING_PROVIDER_JWKS=
TRUSTEQ_PROOFING_PROVIDER_API_KEY=
TRUSTEQ_PROOFING_PROVIDER_REGULATED=false
TRUSTEQ_PROOFING_TTL_SECONDS=900

# {"partner_id": {"keys": [...]}}: public keys of synthetic partners' referral proofs.
TRUSTEQ_PARTNER_REFERRAL_JWKS=

# JSON list of allowed browser origins (future frontend).
TRUSTEQ_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
