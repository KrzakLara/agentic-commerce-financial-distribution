# TRUSTEQ - Secure Agentic Depot Onboarding
# Copy to ".env" for local overrides. ".env" is git-ignored: never commit it.
# Every value below is a safe placeholder. The default application runs
# WITHOUT any external API key (AI execution mode "scripted").
# All variables use the TRUSTEQ_ prefix to avoid clashes with other tools.

TRUSTEQ_APP_NAME=TRUSTEQ Secure Agentic Depot Onboarding
# development | test | production
TRUSTEQ_ENVIRONMENT=development
TRUSTEQ_DEBUG=false
TRUSTEQ_API_VERSION=v1

# SQLite file is created later (Phase 01); it is git-ignored.
TRUSTEQ_DATABASE_URL=sqlite:///./trusteq.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
TRUSTEQ_LOG_LEVEL=INFO
# true = one JSON object per log line, false = human-readable lines
TRUSTEQ_LOG_JSON=true

# scripted = deterministic agent, no API key needed (default)
# llm      = optional model-backed agent; requires TRUSTEQ_ENABLE_LLM=true
TRUSTEQ_AI_EXECUTION_MODE=scripted
TRUSTEQ_ENABLE_LLM=false

# Optional LLM provider configuration (unused in Phase 00; leave empty).
TRUSTEQ_LLM_PROVIDER=
TRUSTEQ_LLM_MODEL=
TRUSTEQ_LLM_BASE_URL=
# Never put a real key in this example file.
TRUSTEQ_LLM_API_KEY=

# DEV/TEST ONLY: lets a caller name its agent actor via the X-Dev-Actor-Id header.
# This is NOT authentication (real scoped mandates arrive in Phase 03). It is ignored in
# production, and production refuses to start if this is set to true.
TRUSTEQ_DEV_ACTOR_AUTH_ENABLED=true

# DEV/TEST ONLY simulated customer sign-in for the bank-controlled confirmation page
# (header X-Dev-Customer-Id / dev sign-in form). Not identity verification; ignored in production.
TRUSTEQ_DEV_CUSTOMER_AUTH_ENABLED=true

# Lifetimes in seconds: customer handoff challenge, onboarding mandate.
TRUSTEQ_HANDOFF_TTL_SECONDS=600
TRUSTEQ_MANDATE_TTL_SECONDS=3600

# Shared secret of the MOCK depot provider's signed callback. Leave EMPTY to disable the
# callback endpoint. Set a long random value only for local demos; never commit it.
# Production refuses to start when this is set.
TRUSTEQ_MOCK_PROVIDER_CALLBACK_SECRET=

# JSON list of allowed browser origins (future frontend).
TRUSTEQ_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
